# 复制为 .env 后按需修改

# 数据库：默认 SQLite（开箱即用）。生产切换 PostgreSQL+pgvector：
# DATABASE_URL=postgresql+psycopg2://heartmind:heartmind@localhost:5432/heartmind
DATABASE_URL=sqlite:///./heartmind.db

# LLM Provider：none(规则降级,无Key也能跑) / openai / anthropic / deepseek / local
LLM_PROVIDER=none
LLM_API_KEY=
# 自定义/本地模型(OpenAI兼容)地址，例如 Ollama：http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.3

# WeChatDataAnalysis 服务地址（可选；不配置则走文本/JSON导入）
# 配置后「新增相亲对象 → 导入聊天记录」支持微信自动导出
# WECHAT_EXPORT_URL=http://127.0.0.1:10392

CORS_ORIGINS=http://localhost:3000
